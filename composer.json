{
    "name": "multiplayer-gratis/api-client",
    "description": "PHP-Client für die REST-API von multiplayer.gratis – kostenloses Gameserver-Hosting.",
    "type": "library",
    "license": "MIT",
    "keywords": ["multiplayer.gratis", "gameserver", "hosting", "api", "client"],
    "homepage": "https://multiplayer.gratis",
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "MultiplayerGratis\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MultiplayerGratis\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
